{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "neon"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "neon-spaces",
                "props": {
                  "tabs": "folded"
                }
              },
              "size": {
                "weight": 1.33
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "neon-agents"
              },
              "size": {
                "weight": 0.67
              },
              "min": 90
            }
          ]
        },
        {
          "id": "skyline",
          "type": "block",
          "content": {
            "mod": "neon",
            "props": {
              "role": "skyline"
            }
          },
          "size": {
            "px": 92
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "neon",
            "props": {
              "role": "footer"
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 358
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "neon-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-col",
              "type": "column",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "neon-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 0,
                      "gap": 10,
                      "lone": true
                    }
                  }
                }
              ],
              "gap": 10
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "neon-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "neon-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 10,
          "gap": 10
        },
        {
          "id": "status-row",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "neon-status"
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 2,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "neon",
  "preview": "layouts/neon.svg"
}
